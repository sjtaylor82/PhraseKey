#Requires AutoHotkey v2.0
#Include ..\PhraseKey\WordRules.ahk

; Builds PhraseKey\WordForms.ahk from infl.txt in AGID, the Automatically
; Generated Inflection Database (http://wordlist.aspell.net). Only forms the
; spelling rules in WordRules.ahk would get wrong are kept.
; Usage: AutoHotkey64.exe MakeWordForms.ahk path\to\infl.txt
if A_Args.Length != 1 {
    FileAppend "Usage: MakeWordForms.ahk path\to\infl.txt`n", "**"
    ExitApp 1
}
verbs := Map(), nouns := Map(), adjectives := Map()
Loop Read A_Args[1] {
    ; word V: past | [participle |] ing | s
    if !RegExMatch(A_LoopReadLine, "^([a-z][a-z']*) ([VNA]): (.*)$", &entry)
        continue
    slots := []
    for slot in StrSplit(entry[3], " | ")
        slots.Push(Preferred(slot))
    word := entry[1]
    switch entry[2] {
        case "V":
            if slots.Length = 4 || slots.Length = 3
                verbs[word] := Map("ed", slots[1], "ing", slots[-2], "s", slots[-1])
        case "N":
            nouns[word] := slots[1]
        case "A":
            if slots.Length = 2
                adjectives[word] := Map("er", slots[1], "est", slots[2])
    }
}
lines := Map()
Note(word, ending, form) {
    if form = "" || form = SuffixRule(word, ending)
        return
    lines[word] := (lines.Has(word) ? lines[word] : word) " " ending "=" form
}
for word, forms in verbs
    for ending in ["ed", "ing"]
        Note(word, ending, forms[ending])
; S is the plural for an irregular noun (men, mice), otherwise the verb form
; (goes, does), otherwise the regular plural.
for word in MergeKeys(verbs, nouns) {
    plural := nouns.Has(word) ? nouns[word] : ""
    ; The list gives many countable nouns (earthling, carp) an unchanged
    ; plural; keep that only for the familiar cases.
    if plural = word && !RegExMatch(word, "(fish|sheep|deer|moose|craft|series|species|offspring)$")
        plural := ""
    if plural != "" && plural != SuffixRule(word, "s")
        Note(word, "s", plural)
    else if verbs.Has(word)
        Note(word, "s", verbs[word]["s"])
    else
        Note(word, "s", plural)
}
for word, forms in adjectives
    for ending in ["er", "est"]
        Note(word, ending, forms[ending])

out := "#Requires AutoHotkey v2.0`n`n"
    . "; Generated by tools\MakeWordForms.ahk; do not edit by hand.`n"
    . "; Word forms the spelling rules in WordRules.ahk would get wrong, from AGID,`n"
    . "; the Automatically Generated Inflection Database:`n"
    . ";`n"
    . ";   Copyright 2000-2014 by Kevin Atkinson`n"
    . ";`n"
    . ";   Permission to use, copy, modify, distribute and sell this database,`n"
    . ";   the associated scripts, the output created form the scripts and its`n"
    . ";   documentation for any purpose is hereby granted without fee,`n"
    . ";   provided that the above copyright notice appears in all copies and`n"
    . ";   that both that copyright notice and this permission notice appear in`n"
    . ";   supporting documentation. Kevin Atkinson makes no representations`n"
    . ";   about the suitability of this array for any purpose. It is provided`n"
    . ";   `"as is`" without express or implied warranty.`n"
    . ";`n"
    . "; AGID's parts of speech come in part from WordNet: WordNet 1.6 Copyright`n"
    . "; 1997 by Princeton University. All rights reserved. See WORDLIST-NOTICE.txt.`n"
    . "WordFormsData() {`n    return `"`n    (`n"
for word, line in lines
    out .= line "`n"
out .= "    )`"`n}`n"
target := A_ScriptDir "\..\PhraseKey\WordForms.ahk"
try FileDelete target
FileAppend out, target, "UTF-8"
FileAppend lines.Count " words written.`n", "*"
ExitApp 0

; The first form in a slot, unless the list itself doubts it.
Preferred(slot) {
    first := StrSplit(slot, ", ")[1]
    if !RegExMatch(first, "^([a-z']+)$", &form)
        return ""
    return form[1]
}
MergeKeys(a, b) {
    all := Map()
    for key in a
        all[key] := true
    for key in b
        all[key] := true
    return all
}
; The list being built is not needed to apply the rules.
WordFormsData() => ""
